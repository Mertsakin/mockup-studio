{
  "name": "mockup-studio",
  "version": "0.6.0",
  "private": true,
  "description": "Browser-based 3D device mockup builder.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "eslint .",
    "render": "node tools/render-harness/harness.js renders/out.png tools/render-harness/scenes/default.js",
    "build:site": "node tools/site/build.mjs",
    "storage:dev": "wrangler dev -c services/storage/wrangler.toml --local --port 8787",
    "accounts:test": "node tools/accounts/test-rls.mjs && node tools/accounts/test-storage.mjs",
    "timeline:test": "node tools/timeline/test-keys.mjs",
    "dev:accounts": "vite --mode accounts --port 5177 --strictPort"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/solar": "^1.2.13",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "opentype.js": "^1.3.4",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.121.0",
    "vite": "^8.3.4",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "denoiser": "^0.0.11",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "mp4-muxer": "^5.2.2",
    "three": "0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.16",
    "webm-muxer": "^5.1.4"
  }
}
