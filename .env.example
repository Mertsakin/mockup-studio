# Accounts (docs/uyelik.md). For development copy to .env.accounts.local and run npm run dev:accounts (plain npm run dev,
# the render harness and the build tools stay without accounts); for the site set
# these in the host's build settings.
# The Supabase URL and anon key are public values (they go to the browser); never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# the storage Worker (services/storage/)
VITE_STORAGE_URL=https://storage.shotlight.studio
# which sign-in buttons show (comma-separated: google, github, apple); the e-mail link is always there
VITE_AUTH_PROVIDERS=google,github,apple
# the capture service (docs/lansman.md)
VITE_CAPTURE_URL=
